# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://mpstme.pics:5432/mpstme_pics

# Auth
JWT_SECRET=supersecurejwtkey

# AWS S3
S3_BUCKET_NAME=mpstme-pics
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY

# Uploads
UPLOAD_MAX_MB=20

# Redis
REDIS_URL=redis://mpstme.pics:6379
